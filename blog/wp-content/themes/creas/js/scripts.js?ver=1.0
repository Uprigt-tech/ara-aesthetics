 $('.gfilter').click(function () {
    $('.slwrap').toggleClass('show');
  });

  // Scroll to #cards-container and update dropdown label
  $('.badge').click(function (e) {
    e.preventDefault();

    const selectedText = $(this).text().trim();

    // Close the dropdown list (mobile)
    $('.slwrap').removeClass('show');

    // Update the dropdown button label (mobile)
    $('#dropdownToggle').text(selectedText);

    // Remove 'active' from all, add to current
    $('.badge').removeClass('active');
    $(this).addClass('active');

  });
});

/* GSAP */
gsap.registerPlugin(ScrollTrigger);

/* Footer animation */
gsap.to("footer", {
    scrollTrigger: {
        trigger: "footer",
        start: "top bottom",
        toggleActions: "play none none reverse"
    },
    y: 0,
    opacity: 1,
    duration: 1,
    ease: "power2.out"
});

/* Span animations */
gsap.utils.toArray(".fenq .ch2 span").forEach((el, i) => {
    const fromX = i % 2 === 0 ? -150 : 150;

    gsap.set(el, { x: fromX });

    gsap.to(el, {
        x: 0,
        scrollTrigger: {
            trigger: el,
            start: "top 95%",
            end: "top 30%",
            scrub: 1
        }
    });
});
  const menuItems = document.querySelectorAll('.cta1');

  menuItems.forEach(item => {
    const submenu = item.querySelector('.sub-menu');

    if (submenu) {
      item.addEventListener('mouseenter', () => {
        item.classList.add('active');
      });

      item.addEventListener('mouseleave', () => {
        item.classList.remove('active');
      });
    }
  });
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('post-search');
    const categoryButtons = document.querySelectorAll('.filter-category');
    const posts = Array.from(document.querySelectorAll('.blog-item'));
    let activeCategory = 'all';

    categoryButtons.forEach(btn => {
        btn.addEventListener('click', function () {
            activeCategory = this.dataset.category;
            filterPosts();
        });
    });

    searchInput.addEventListener('input', filterPosts);

    // Initial reveal
    revealVisiblePosts();

    function filterPosts() {
        const searchTerm = searchInput.value.toLowerCase();
        let visiblePosts = [];

        posts.forEach(post => {
            const title = post.dataset.title || '';
            const catNames = post.dataset.catNames?.split(' ') || [];
            const catSlugs = post.dataset.categories?.split(' ') || [];

            const catMatch = activeCategory === 'all' || catSlugs.includes(activeCategory);
            const searchMatch =
                title.includes(searchTerm) ||
                catNames.some(n => n.includes(searchTerm));

            if (catMatch && searchMatch) {
                post.classList.remove('is-hidden');
                visiblePosts.push(post);
            } else {
                post.classList.add('is-hidden');
                post.classList.remove('is-visible');
            }
        });

        staggerReveal(visiblePosts);
    }

    function staggerReveal(elements) {
        elements.forEach((el, i) => {
            el.classList.remove('is-visible');
            setTimeout(() => {
                el.classList.add('is-visible');
            }, i * 80); // stagger delay
        });
    }

    function revealVisiblePosts() {
        const visible = posts.filter(p => !p.classList.contains('is-hidden'));
        staggerReveal(visible);
    }
});




