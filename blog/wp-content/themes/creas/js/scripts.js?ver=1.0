jQuery(function ($) {

    /* Sticky Header */
    if ($.fn.spSticyheader) {
        $('header').spSticyheader({
            hideHeaderTarget: '.preheader',
            scrollHeader: 200,
            customClass: 'make-small',
            mobileHeader: true
        });
    }

    /* Toggle menus */
    $(".qlh").on("click", function () {
        $(this).toggleClass('iclose');
        $(".qlinks").toggleClass("open");
    });

    $(".cuh").on("click", function () {
        $(this).toggleClass('iclose');
        $(".grid2").toggleClass("open");
    });

    $(".ph").on("click", function () {
        $(this).toggleClass('iclose');
        $(".plinks").toggleClass("open");
    });

    $(".adh2").on("click", function () {
        $(this).toggleClass('iclose');
        $(".adcnt").toggleClass("open");
    });

    $(".prh").on("click", function () {
        $(this).toggleClass('iclose');
        $(".prlinks").toggleClass("open");
    });

    $(".ph1").on("click", function () {
        $(this).toggleClass('iclose');
        $(".plinks1").toggleClass("open");
    });

    $(".sh").on("click", function () {
        $(this).toggleClass('iclose');
        $(".slinks").toggleClass("open");
    });

    $(".side-menu-close").on("click", function () {
        $('html').toggleClass('oflow');
    });

    /* Scroll actions */
    $(window).on("scroll", function () {
        let scrollTop = $(this).scrollTop();

        if (scrollTop > 200) {
            $('#scroll, #whatsapp').fadeIn();
            $(".sse").css("opacity", "1");
        } else {
            $('#scroll, #whatsapp').fadeOut();
        }
    });
